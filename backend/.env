# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# YOLO Computer Vision Model
# Specified location: ../ai/models/best.pt
YOLO_MODEL_PATH=../ai/models/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./database/onion_quality.db

# Storage Directories
UPLOAD_DIR=./uploads

# Configurable Agricultural Grading Rules (Customizable per harvest/market standards)
# Default demonstration baseline
GRADE_A_MIN_HEALTHY_PCT=70.0
GRADE_A_MAX_ROTTEN_PCT=5.0
GRADE_A_MAX_DAMAGED_PCT=15.0
GRADE_A_MAX_SPROUTED_PCT=10.0
GRADE_A_MAX_UNDERSIZED_PCT=15.0
URS_CRITICAL_ROTTEN_PCT=8.0
